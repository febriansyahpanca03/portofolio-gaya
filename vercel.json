{
  "version": 2,
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.7.4" },
    { "src": "public/*.{ico,txt}", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/favicon.ico", "dest": "public/favicon.ico" },
    { "src": "/robots.txt", "dest": "public/robots.txt" },
    { "src": "/(.*)", "dest": "api/index.php" }
  ],
  "env": {
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "LOG_CHANNEL": "stderr",
    "LOG_EMERGENCY_PATH": "/tmp/laravel-emergency.log",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "APP_MAINTENANCE_DRIVER": "file",
    "APP_NAME": "Gayatri Dewi Portfolio",
    "APP_ENV": "production",
    "APP_URL": "https://portofolio-gaya.vercel.app",
    "APP_LOCALE": "id",
    "APP_FALLBACK_LOCALE": "en",
    "APP_FAKER_LOCALE": "id_ID",
    "APP_TIMEZONE": "UTC",
    "BCRYPT_ROUNDS": "12",
    "DB_CONNECTION": "sqlite",
    "SESSION_LIFETIME": "120",
    "SESSION_ENCRYPT": "false",
    "SESSION_PATH": "/",
    "BROADCAST_CONNECTION": "log",
    "FILESYSTEM_DISK": "local",
    "QUEUE_CONNECTION": "sync"
  }
}
